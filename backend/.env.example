# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Database (PostgreSQL / Supabase) ─────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connect_timeout=30"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?connect_timeout=30"

# ─── Redis Cache & Queue (Upstash) ────────────────────────
REDIS_URL="rediss://default:[YOUR-UPSTASH-TOKEN]@[YOUR-ENDPOINT].upstash.io:6379"

# ─── JWT Authentication ───────────────────────────────────
JWT_SECRET="your-ultra-secure-access-jwt-secret-min-32-chars"
JWT_REFRESH_SECRET="your-ultra-secure-refresh-jwt-secret-min-32-chars"

# ─── Chapa Payment Gateway ────────────────────────────────
CHAPA_PUBLIC_KEY="CHAPA_TEST_PUB_xxxxxxxxxxxxxxxxxxxx"
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx"
CHAPA_WEBHOOK_SECRET="your-chapa-webhook-secret-token"
CHAPA_WEBHOOK_URL="https://your-api-domain.com/api/v1/payments/webhook"

# ─── Cloudinary Media Storage ─────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"

# ─── Transactional Email (Nodemailer) ─────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
EMAIL_FROM="SmartDeliver <no-reply@smartdeliver.com>"

# ─── AI Support Engine (Gemini) ───────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ─── Observability (Optional) ─────────────────────────────
SENTRY_DSN=""
